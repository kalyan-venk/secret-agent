# Copy to .env.local (git-ignored, never commit the real file) to run the
# hosted LLM provider path. Config.from_env() reads .env.local automatically;
# see secret_agent/config.py's _load_dotenv_local.
#
# Everything below is optional. With nothing set, LLM_PROVIDER defaults to
# "ollama" and the runtime behaves exactly as it always has.

# "ollama" (default) or "hosted".
LLM_PROVIDER=hosted

# Groq's free tier is the default hosted provider (base_url and model below
# already point at it). Get a key at https://console.groq.com, no credit
# card required.
GROQ_API_KEY=

# Only needed to point at a different OpenAI-compatible provider instead of
# Groq. SA_HOSTED_API_KEY wins over GROQ_API_KEY if both are set.
# SA_HOSTED_API_KEY=
# SA_HOSTED_BASE_URL=https://api.groq.com/openai/v1
# SA_HOSTED_MODEL=llama-3.1-8b-instant

# Gemini's OpenAI-compatible endpoint, as an example of swapping provider
# with no code change:
# SA_HOSTED_API_KEY=your-gemini-key
# SA_HOSTED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# SA_HOSTED_MODEL=gemini-1.5-flash

# OpenRouter, another example:
# SA_HOSTED_API_KEY=your-openrouter-key
# SA_HOSTED_BASE_URL=https://openrouter.ai/api/v1
# SA_HOSTED_MODEL=meta-llama/llama-3.1-8b-instruct:free
